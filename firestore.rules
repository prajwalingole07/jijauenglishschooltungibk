rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // JIJAU Portal - allow all reads/writes (custom local auth, not Firebase Auth)
    // For stricter security later, replace with: allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
